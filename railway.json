{
  "name": "FanScript-Server",
  "version": "1.0.0",
  "description": "FanScript Backend - NestJS API for ticketing",
  "build": {
    "builder": "NIXPACKS.Builder",
    "options": {
      "nodeVersion": "20"
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}